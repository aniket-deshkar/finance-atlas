{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Finance Atlas",
  "version": "0.2.0",
  "identifier": "app.financeatlas.desktop",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "npm.cmd run build",
    "beforeBuildCommand": "npm.cmd run build"
  },
  "app": {
    "windows": [
      {
        "title": "Finance Atlas",
        "width": 1360,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "create": false,
        "minWidth": 720,
        "minHeight": 540,
        "center": true,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'self'",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Private, encrypted personal finance workspace",
    "category": "Finance",
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English"
        ]
      }
    }
  }
}
